# ╔══════════════════════════════════════════════════════════╗
# ║           Environment Variables — .env.example           ║
# ║  Copy this to .env and fill in real values.              ║
# ║  NEVER commit .env to source control.                    ║
# ╚══════════════════════════════════════════════════════════╝

# Server
SERVER_PORT=8080
LOG_LEVEL=INFO

# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=YOUR_APP
MONGODB_DATABASE=appdb

# Redis
# When running via Docker Compose, REDIS_HOST is overridden to "redis" automatically.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_password

# JWT
# Generate a secure secret (min 256-bit):
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_256BIT_SECRET
JWT_ACCESS_EXPIRY_MS=900000       # 15 minutes
JWT_REFRESH_EXPIRY_MS=604800000   # 7 days
JWT_ISSUER=springboot-auth