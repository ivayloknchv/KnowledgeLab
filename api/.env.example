# ╔══════════════════════════════════════════════════════════╗
# ║           Environment Variables — .env.example           ║
# ║  Copy this to .env and fill in real values.              ║
# ║  NEVER commit .env to source control.                    ║
# ╚══════════════════════════════════════════════════════════╝

# Server
SERVER_PORT=8080
LOG_LEVEL=INFO

# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&authSource=<role>
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=YOUR_APP
MONGODB_DATABASE=appdb

# Redis
# When running via Docker Compose, REDIS_HOST is overridden to "redis" automatically.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_password

# JWT
# Generate a secure secret (min 256-bit):
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_256BIT_SECRET
JWT_ACCESS_EXPIRY_MS=900000       # 15 minutes
JWT_REFRESH_EXPIRY_MS=604800000   # 7 days
JWT_ISSUER=knowledge-lab

# CORS
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Kafka
# When running via Docker Compose, KAFKA_BOOTSTRAP_SERVERS is overridden to "kafka:29092" automatically.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ANNOTATION_EVENTS=annotation-events
KAFKA_TOPIC_ANNOTATION_EVENTS_DLT=annotation-events.DLT
KAFKA_TOPIC_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_CONSUMER_GROUP_ID=knowledge-lab-annotation-group
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Elasticsearch
# When running via Docker Compose, ELASTICSEARCH_URI is overridden to "http://elasticsearch:9200" automatically.
ELASTICSEARCH_URI=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=